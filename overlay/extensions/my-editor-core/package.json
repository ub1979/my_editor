{
  "name": "my-editor-core",
  "displayName": "my_editor Core",
  "description": "Built-in core of my_editor: project brain, skills, pair mode.",
  "version": "0.0.1",
  "publisher": "my-editor",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "myEditor.home",
        "title": "Home",
        "category": "my_editor"
      },
      {
        "command": "myEditor.chooseModel",
        "title": "Choose Default Model",
        "category": "my_editor"
      },
      {
        "command": "myEditor.setApiKey",
        "title": "Set API Key",
        "category": "my_editor"
      },
      {
        "command": "myEditor.buildBrain",
        "title": "Build Project Brain",
        "category": "my_editor"
      },
      {
        "command": "myEditor.navigator.toggle",
        "title": "Pause / Resume Navigator",
        "category": "my_editor"
      },
      {
        "command": "myEditor.navigator.muteFile",
        "title": "Mute / Unmute Navigator for This File",
        "category": "my_editor"
      },
      {
        "command": "myEditor.navigator.clear",
        "title": "Clear Navigator Notes",
        "category": "my_editor"
      },
      {
        "command": "myEditor.saveDecision",
        "title": "Save as Decision",
        "category": "my_editor"
      },
      {
        "command": "myEditor.checkFit",
        "title": "Check How These Fit",
        "category": "my_editor"
      },
      {
        "command": "myEditor.scaffold",
        "title": "Scaffold Files From Tree",
        "category": "my_editor"
      },
      {
        "command": "myEditor.nextFile",
        "title": "Open Next File to Build",
        "category": "my_editor"
      },
      {
        "command": "myEditor.toggleDone",
        "title": "Mark File Done / In Progress",
        "category": "my_editor"
      },
      {
        "command": "myEditor.adaptFile",
        "title": "Adapt File to a Change",
        "category": "my_editor"
      },
      {
        "command": "myEditor.proposal.keep",
        "title": "Keep This Change",
        "category": "my_editor",
        "icon": "$(check)"
      },
      {
        "command": "myEditor.proposal.undo",
        "title": "Undo This Change",
        "category": "my_editor",
        "icon": "$(discard)"
      },
      {
        "command": "myEditor.chat.start",
        "title": "Start a Skill",
        "category": "my_editor"
      },
      {
        "command": "myEditor.chat.ask",
        "title": "Ask the Pair",
        "category": "my_editor"
      },
      {
        "command": "myEditor.chat.skills",
        "title": "Skills",
        "category": "my_editor",
        "icon": "$(layout)"
      },
      {
        "command": "myEditor.chat.new",
        "title": "New Chat",
        "category": "my_editor",
        "icon": "$(add)"
      }
    ],
    "configuration": {
      "title": "my_editor",
      "properties": {
        "myEditor.models.default": {
          "type": "string",
          "default": "",
          "markdownDescription": "Default chat model as `provider:model`, e.g. `claude-cli:sonnet`, `anthropic:claude-opus-5`, `codex-cli:default`, `ollama:qwen3.5:9b-mlx` or `lmstudio:<model>`. Empty: Anthropic API, else Claude subscription, else Codex, else a local model."
        },
        "myEditor.anthropic.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude-opus-5",
            "claude-sonnet-5",
            "claude-haiku-4-5",
            "claude-fable-5-1"
          ],
          "description": "Claude models offered when an Anthropic key is set."
        },
        "myEditor.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI API base URL. Only settable in user settings, so a project cannot redirect it.",
          "scope": "machine"
        },
        "myEditor.openai.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "OpenAI models to offer."
        },
        "myEditor.openrouter.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "OpenRouter model ids to offer."
        },
        "myEditor.custom.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of any OpenAI-compatible endpoint. Only settable in user settings, so a project cannot redirect it.",
          "scope": "machine"
        },
        "myEditor.custom.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Model ids served by the custom endpoint."
        },
        "myEditor.ollama.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer models from a running Ollama."
        },
        "myEditor.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama URL. Only settable in user settings, so a project cannot redirect it.",
          "scope": "machine"
        },
        "myEditor.ollama.think": {
          "type": "boolean",
          "default": false,
          "description": "Let Ollama thinking models think before answering (slower)."
        },
        "myEditor.records.chatHistory": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Save conversations to `.my_editor/chats/` (secrets are redacted)."
        },
        "myEditor.navigator.enabled": {
          "type": "boolean",
          "default": true,
          "description": "After each save, review the changed lines and show at most three notes. Never edits code."
        },
        "myEditor.navigator.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model for the navigator as `provider:model`. Empty: a local Ollama model, else Claude Haiku 4.5, else the default model."
        },
        "myEditor.claudeCli.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer Claude through your Claude Code login (subscription) when the `claude` command is installed."
        },
        "myEditor.claudeCli.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `claude` command. Empty: found on PATH or in the usual install folders. Only settable in user settings, so a project cannot redirect it.",
          "scope": "machine"
        },
        "myEditor.claudeCli.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "opus",
            "sonnet",
            "haiku"
          ],
          "markdownDescription": "Claude Code model names to offer (`opus`, `sonnet`, `haiku`, a full model id, or `default`)."
        },
        "myEditor.codexCli.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer GPT through your Codex login (ChatGPT subscription) when the `codex` command is installed."
        },
        "myEditor.codexCli.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `codex` command. Empty: found on PATH or in the usual install folders. Only settable in user settings, so a project cannot redirect it.",
          "scope": "machine"
        },
        "myEditor.codexCli.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "default"
          ],
          "markdownDescription": "Codex model names to offer; `default` uses the model in your Codex config."
        },
        "myEditor.lmstudio.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer models from LM Studio's local server when it is running."
        },
        "myEditor.lmstudio.baseUrl": {
          "type": "string",
          "default": "http://localhost:1234/v1",
          "description": "LM Studio server URL (OpenAI-compatible). Only settable in user settings, so a project cannot redirect it.",
          "scope": "machine"
        }
      }
    },
    "views": {
      "myEditor": [
        {
          "type": "webview",
          "id": "myEditor.project",
          "name": "Project"
        }
      ],
      "myEditorPair": [
        {
          "type": "webview",
          "id": "myEditor.chat",
          "name": "Pair"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myEditor",
          "title": "Project",
          "icon": "media/project-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "myEditorPair",
          "title": "Pair",
          "icon": "media/pair-icon.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "myEditor.saveDecision",
          "when": "false"
        },
        {
          "command": "myEditor.adaptFile",
          "when": "false"
        },
        {
          "command": "myEditor.chat.start",
          "when": "false"
        },
        {
          "command": "myEditor.chat.ask",
          "when": "false"
        },
        {
          "command": "myEditor.proposal.keep",
          "when": "resourceScheme == my-editor-proposal"
        },
        {
          "command": "myEditor.proposal.undo",
          "when": "resourceScheme == my-editor-proposal"
        }
      ],
      "explorer/context": [
        {
          "command": "myEditor.checkFit",
          "group": "7_modification@9",
          "when": "explorerResourceIsFolder || listMultiSelection || resourceExtname =~ /\\.(ts|tsx|js|jsx|mjs|cjs|py)$/"
        }
      ],
      "editor/title": [
        {
          "command": "myEditor.proposal.keep",
          "when": "resourceScheme == my-editor-proposal",
          "group": "navigation@1"
        },
        {
          "command": "myEditor.proposal.undo",
          "when": "resourceScheme == my-editor-proposal",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "myEditor.chat.skills",
          "when": "view == myEditor.chat",
          "group": "navigation@1"
        },
        {
          "command": "myEditor.chat.new",
          "when": "view == myEditor.chat",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --noEmit -p ./ && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.2",
    "typescript": "^5.9.0"
  }
}
