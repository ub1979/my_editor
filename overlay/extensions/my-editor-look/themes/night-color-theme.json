	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#8a917f",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"variable.language.this",
				"variable.language.self"
			],
			"settings": {
				"foreground": "#e8bd6c"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#a4aa9c"
			}
		},
		{
			"scope": [
				"string",
				"string.template",
				"punctuation.definition.string",
				"string.regexp",
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#aac38f"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other",
				"support.constant"
			],
			"settings": {
				"foreground": "#e39a84"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function"
			],
			"settings": {
				"foreground": "#9cc2dc"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"entity.name.namespace",
				"storage.type.primitive"
			],
			"settings": {
				"foreground": "#8ccabf"
			}
		},
		{
			"scope": [
				"variable",
				"variable.parameter",
				"variable.other",
				"meta.definition.variable",
				"support.variable"
			],
			"settings": {
				"foreground": "#e9e6da"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml"
			],
			"settings": {
				"foreground": "#e8bd6c"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"support.type.property-name",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#d9c28a"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#e9e6da",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#e9e6da",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#e9e6da",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#e8bd6c"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#8a917f",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.list punctuation.definition.list",
				"punctuation.definition.heading"
			],
			"settings": {
				"foreground": "#e8bd6c"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#c2513a"
			}
		}
	],
	"semanticTokenColors": {
		"parameter": "#cfcdbf",
		"property.declaration": "#e9e6da"
	}
}
