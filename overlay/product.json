{
  "nameShort": "my_editor",
  "nameLong": "my_editor",
  "applicationName": "my_editor",
  "dataFolderName": ".my_editor",
  "urlProtocol": "my-editor",
  "darwinBundleIdentifier": "dev.my-editor.app",
  "serverApplicationName": "my_editor-server",
  "serverDataFolderName": ".my_editor-server",
  "tunnelApplicationName": "my_editor-tunnel",
  "updateUrl": "",
  "downloadUrl": "",
  "reportIssueUrl": "",
  "licenseUrl": "",
  "configurationDefaults": {
    "workbench.colorTheme": "my_editor Paper",
    "workbench.preferredDarkColorTheme": "my_editor Night",
    "workbench.preferredLightColorTheme": "my_editor Paper",
    "workbench.iconTheme": "vs-minimal",
    "workbench.activityBar.location": "top",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.editor.centeredLayoutAutoResize": false,
    "workbench.editor.centeredLayoutFixedWidth": true,
    "workbench.editor.tabActionCloseVisibility": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.wrapTabs": false,
    "workbench.tree.indent": 14,
    "workbench.tree.renderIndentGuides": "onHover",
    "workbench.list.smoothScrolling": true,
    "workbench.secondarySideBar.defaultVisibility": "visibleInWorkspace",
    "window.commandCenter": true,
    "window.title": "${rootName}${separator}${activeEditorShort}",
    "breadcrumbs.enabled": false,
    "explorer.compactFolders": false,
    "explorer.decorations.badges": false,
    "extensions.ignoreRecommendations": true,
    "editor.fontFamily": "'SF Mono', Menlo, Monaco, monospace",
    "editor.fontSize": 14,
    "editor.lineHeight": 1.75,
    "editor.letterSpacing": 0.2,
    "editor.padding.top": 28,
    "editor.padding.bottom": 120,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.lightbulb.enabled": "off",
    "editor.glyphMargin": false,
    "editor.folding": true,
    "editor.showFoldingControls": "mouseover",
    "editor.renderLineHighlight": "line",
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.scrollbar.verticalScrollbarSize": 8,
    "editor.scrollbar.horizontalScrollbarSize": 8,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "editor.bracketPairColorization.enabled": false,
    "editor.guides.bracketPairs": false,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.occurrencesHighlight": "singleFile",
    "editor.matchBrackets": "near",
    "editor.renderWhitespace": "none",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.lineHeight": 1.25,
    "[markdown]": {
      "editor.fontFamily": "'Iowan Old Style', 'Palatino', Georgia, serif",
      "editor.fontSize": 17,
      "editor.lineHeight": 1.8,
      "editor.letterSpacing": 0,
      "editor.wordWrap": "bounded",
      "editor.wordWrapColumn": 76,
      "editor.lineNumbers": "off",
      "editor.renderLineHighlight": "none",
      "editor.quickSuggestions": {
        "comments": "off",
        "strings": "off",
        "other": "off"
      }
    },
    "chat.disableAIFeatures": true,
    "diffEditor.renderSideBySide": false,
    "diffEditor.renderMarginRevertIcon": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "window.restoreWindows": "none"
  }
}
